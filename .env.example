# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
HUDDLE_DATABASE_URL=sqlite:///./data/huddle.db
# Postgres (production) -- migrations are written portably for this switch
# HUDDLE_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/huddle

# --- Yoto application -----------------------------------------------------
# Create an app at https://dashboard.yoto.dev and register the redirect URL
# below. A *public* client (no secret) is the recommended setup.
HUDDLE_YOTO_CLIENT_ID=
# Only for a confidential client. Leave empty for a public client -- the flow
# uses PKCE either way.
HUDDLE_YOTO_CLIENT_SECRET=
HUDDLE_YOTO_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# --- Security -------------------------------------------------------------
# Signs the parent's login cookie. Without it everyone is signed out on every
# restart. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
HUDDLE_SESSION_SECRET=

# Encrypts Yoto refresh tokens at rest. Strongly recommended before anyone
# but you uses this. Generate with:
#   python -c "from huddle.yoto.secrets import generate_key; print(generate_key())"
HUDDLE_TOKEN_ENCRYPTION_KEY=

# --- Audio ----------------------------------------------------------------
# labs   = Yoto synthesises the script server-side (default, no extra keys)
# upload = synthesise locally, then upload and transcode
HUDDLE_AUDIO_PIPELINE=labs

# One ElevenLabs voice per host. Two distinct voices are what make the show a
# conversation rather than a monologue.
HUDDLE_NOVA_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
HUDDLE_RAE_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Only needed for HUDDLE_AUDIO_PIPELINE=upload.
HUDDLE_ELEVENLABS_API_KEY=
HUDDLE_ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Narration (optional) -------------------------------------------------
# When enabled, a model rewrites each written segment to sound more natural.
# It may only rephrase what the writer produced -- a rewrite that introduces a
# number or a name the source did not contain is rejected automatically.
HUDDLE_NARRATION_ENABLED=false
HUDDLE_NARRATION_MODEL=claude-opus-5
HUDDLE_ANTHROPIC_API_KEY=

# --- Web ------------------------------------------------------------------
HUDDLE_WEB_BASE_URL=http://127.0.0.1:8787

# --- Scheduling -----------------------------------------------------------
HUDDLE_DEFAULT_PUBLISH_HOUR=6
HUDDLE_DEFAULT_TIMEZONE=America/New_York

# --- Testing --------------------------------------------------------------
# Serve recorded fixtures instead of the live API. Never set in production.
HUDDLE_USE_FIXTURES=false
