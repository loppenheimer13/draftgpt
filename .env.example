# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# SQLite (default, local vertical slice)
DRAFTGPT_DATABASE_URL=sqlite:///./data/draftgpt.db
# Postgres (production) -- migrations are written portably for this switch
# DRAFTGPT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/draftgpt

# --- League ---------------------------------------------------------------
DRAFTGPT_SEASON=2026
DRAFTGPT_LEAGUE_PROVIDER=espn
DRAFTGPT_ESPN_LEAGUE_ID=
# Private ESPN leagues require these two cookies from a logged-in browser
# session (Application > Cookies > espn.com). Read-only use.
DRAFTGPT_ESPN_S2=
DRAFTGPT_ESPN_SWID=

# --- Explanations (optional; the engine is fully functional without it) ----
# The LLM never sources facts -- it only narrates the decision snapshot.
ANTHROPIC_API_KEY=
DRAFTGPT_EXPLANATION_MODEL=claude-sonnet-5
DRAFTGPT_EXPLANATIONS_ENABLED=false
